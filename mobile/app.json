{
  "expo": {
    "name": "TTAMASS",
    "slug": "ttamass",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.ttamass.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "fr.ttamass.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "TTAMASS utilise tes photos pour analyser ton repas.",
          "cameraPermission": "TTAMASS utilise l'appareil photo pour analyser ton repas."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "À_REMPLIR_DEPUIS_EAS"
      }
    }
  }
}
