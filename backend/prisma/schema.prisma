// TTAMASS — Prisma Schema
// PostgreSQL via Supabase
// Auth gérée par Supabase Auth (auth.users), on lie via userId (UUID)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// PROFIL UTILISATEUR
// ─────────────────────────────────────────────

model UserProfile {
  id        String   @id @default(uuid())
  userId    String   @unique // lié à auth.users.id de Supabase
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Données physiques
  birthDate DateTime?
  gender    Gender?
  heightCm  Float?
  weightKg  Float? // poids initial à l'inscription

  // Niveau d'activité et objectif
  activityLevel ActivityLevel @default(SEDENTARY)
  goal          Goal          @default(RECOMPOSITION)

  // Objectifs caloriques/macros (calculés ou manuels)
  targetCalories   Int?
  targetProteinG   Int?
  targetCarbsG     Int?
  targetFatG       Int?
  manualOverride   Boolean @default(false) // true si l'user a modifié manuellement

  // Abonnement
  plan          Plan      @default(FREE)
  trialEndsAt   DateTime?
  subscriptionId String?  // référence Stripe ou Apple IAP

  // Streak
  currentStreak Int @default(0)
  longestStreak Int @default(0)
  lastTrackedAt DateTime?

  // Notifications push (Expo)
  expoPushToken      String?
  notifStreakReminder Boolean @default(false)

  // Relations
  foodEntries    FoodEntry[]
  bodyMetrics    BodyMetric[]
  bodyPhotos     BodyPhoto[]
  workoutSessions WorkoutSession[]
  customFoods    Food[]           @relation("CustomFoods")
  customExercises Exercise[]      @relation("CustomExercises")
  aiConversations AiConversation[]

  @@map("user_profiles")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ActivityLevel {
  SEDENTARY       // Sédentaire (bureau, peu de sport)
  LIGHTLY_ACTIVE  // Légèrement actif (1-3j/semaine)
  MODERATELY_ACTIVE // Modérément actif (3-5j/semaine)
  VERY_ACTIVE     // Très actif (6-7j/semaine)
  EXTRA_ACTIVE    // Extrêmement actif (athlète, travail physique)
}

enum Goal {
  RECOMPOSITION   // Recomposition corporelle
  BULK            // Prise de masse
  CUT             // Sèche
  MAINTENANCE     // Maintien
}

enum Plan {
  FREE
  PREMIUM
}

// ─────────────────────────────────────────────
// MODULE NUTRITION — ALIMENTS
// ─────────────────────────────────────────────

model Food {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name    String
  brand   String?
  barcode String? @unique

  // Source de l'aliment
  source   FoodSource @default(CUSTOM)
  offId    String?    @unique // Open Food Facts ID (barcode ou off-id)

  // Unité de mesure et quantité par défaut proposée à l'utilisateur
  unit            FoodUnit @default(G)
  defaultQuantity Float    @default(100)

  // Valeurs nutritionnelles pour 100g / 100ml
  caloriesPer100g Float
  proteinPer100g  Float
  carbsPer100g    Float
  fatPer100g      Float
  fiberPer100g    Float?
  sugarPer100g    Float?
  sodiumPer100g   Float?

  // Aliment custom créé par un utilisateur
  createdByUserId String?
  createdBy       UserProfile? @relation("CustomFoods", fields: [createdByUserId], references: [userId])

  foodEntries FoodEntry[]

  @@index([barcode])
  @@index([name])
  @@map("foods")
}

enum FoodUnit {
  G  // grammes (solides)
  ML // millilitres (boissons)
}

enum FoodSource {
  OPEN_FOOD_FACTS // importé depuis Open Food Facts
  CUSTOM          // créé manuellement par l'utilisateur
  AI_DETECTED     // détecté par la reconnaissance photo IA
}

// ─────────────────────────────────────────────
// MODULE NUTRITION — ENTRÉES JOURNALIÈRES
// ─────────────────────────────────────────────

model FoodEntry {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId    String
  user      UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  date      DateTime // date du jour (sans heure pour grouper par journée)
  mealType  MealType

  foodId    String
  food      Food    @relation(fields: [foodId], references: [id])

  // Quantité consommée
  quantityG Float // en grammes

  // Valeurs calculées (dénormalisées pour éviter les recalculs)
  calories  Float
  proteinG  Float
  carbsG    Float
  fatG      Float

  @@index([userId, date])
  @@map("food_entries")
}

enum MealType {
  BREAKFAST // Petit-déjeuner
  LUNCH     // Déjeuner
  DINNER    // Dîner
  SNACK     // Collation
}

// ─────────────────────────────────────────────
// MODULE CORPS & PROGRESSION
// ─────────────────────────────────────────────

model BodyMetric {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId String
  user   UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  date DateTime // date de la mesure

  // Poids
  weightKg Float?

  // Mensurations (cm)
  waistCm  Float? // tour de taille
  chestCm  Float? // poitrine
  armCm    Float? // bras (biceps)
  thighCm  Float? // cuisse

  // Calculs optionnels
  bmi Float? // IMC calculé

  @@index([userId, date])
  @@map("body_metrics")
}

model BodyPhoto {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId String
  user   UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  date    DateTime
  url     String        // URL Supabase Storage ou Cloudflare R2
  type    BodyPhotoType
  notes   String?

  @@index([userId, date])
  @@map("body_photos")
}

enum BodyPhotoType {
  FRONT
  BACK
  SIDE_LEFT
  SIDE_RIGHT
}

// ─────────────────────────────────────────────
// MODULE SPORT
// ─────────────────────────────────────────────

model Exercise {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  name        String      @unique
  muscleGroup MuscleGroup
  isCustom    Boolean @default(false)

  // Si exercice custom, lié à l'utilisateur qui l'a créé
  createdByUserId String?
  createdBy       UserProfile? @relation("CustomExercises", fields: [createdByUserId], references: [userId])

  workoutSets WorkoutSet[]

  @@index([muscleGroup])
  @@map("exercises")
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  FOREARMS
  ABS
  GLUTES
  QUADS
  HAMSTRINGS
  CALVES
  FULL_BODY
  CARDIO
}

model WorkoutSession {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  date     DateTime
  name     String?  // ex: "Push A", "Legs"
  notes    String?
  duration Int?     // durée en minutes

  workoutSets WorkoutSet[]

  @@index([userId, date])
  @@map("workout_sessions")
}

model WorkoutSet {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  sessionId  String
  session    WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])

  setNumber  Int    // numéro de la série (1, 2, 3...)
  reps       Int?   // répétitions
  weightKg   Float? // charge en kg
  durationSec Int?  // pour les exercices isométriques (planche...)
  notes      String?

  @@index([sessionId])
  @@index([exerciseId])
  @@map("workout_sets")
}

// ─────────────────────────────────────────────
// MODULE IA — CONVERSATIONS COACH
// ─────────────────────────────────────────────

model AiConversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  messages AiMessage[]

  @@index([userId])
  @@map("ai_conversations")
}

model AiMessage {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    AiMessageRole
  content String        @db.Text

  // Tokens utilisés (pour le suivi des coûts API)
  inputTokens  Int?
  outputTokens Int?

  @@index([conversationId])
  @@map("ai_messages")
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}
